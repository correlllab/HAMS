# Dedicated runtime for the official VLMaps LSeg baseline.
#
# The official VLMaps checkout and checkpoint are mounted at runtime. Habitat,
# ROS, and RoboCasa are deliberately excluded: evaluation consumes the frozen
# benchmark's RGB-D frames and camera poses only.
FROM pytorch/pytorch:2.7.1-cuda12.8-cudnn9-runtime

LABEL org.hams.vlmaps-runtime="2"

RUN apt-get update && apt-get install -y --no-install-recommends \
        git libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
        "gdown==5.2.0" \
        "h5py==3.14.0" \
        "matplotlib==3.10.3" \
        "opencv-python-headless==4.11.0.86" \
        "pandas==2.3.1" \
        "PyYAML==6.0.2" \
        "scipy==1.16.0" \
        "timm==0.9.16" \
        "ftfy==6.3.1" \
        "regex==2024.11.6" \
        "tqdm==4.67.1" \
    && pip install --no-cache-dir \
        "git+https://github.com/openai/CLIP.git@dcba3cb2e2827b402d2701e7e1c7d9fed8a20ef1"

ENV PYTHONUNBUFFERED=1
WORKDIR /opt/Humanoid_Simulation

CMD ["python", "-m", "benchmarks.spatial_memory.evaluate", "--help"]
